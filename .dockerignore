# Explicit build inputs keep local configuration, secrets, caches and test output out.
**
!Dockerfile
!backend/
backend/**
!backend/pyproject.toml
!backend/poetry.lock
!backend/backlight_tracker/
backend/backlight_tracker/**
!backend/backlight_tracker/**/*.py
!frontend/
frontend/**
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**
!frontend/public/
frontend/public/**
!frontend/public/images/
!frontend/public/images/**
!test_images/
test_images/**
!test_images/*.jpg
!test_images/*.jpeg
!test_images/*.png
